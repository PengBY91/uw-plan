{
  "name": "slope_wall_v1",
  "purpose": "W2-11 sonar elevation-ambiguity check (detect-a vertical-structure gate): the stripe_wall_h_v1 brick wall and route, with the half at x > 0 tilted 35 deg from vertical about the line y = -0.25, z = -20 (face top leaning away from the vehicle, like the Dam face, ~37 deg). The vehicle backs off from 2.5 m to 4.5 m and returns once over each half, because the elevation ambiguity only shows when the range changes; the return leg is at constant stand-off. Sonar is the raycast model from the start.",
  "world": "OpenWater",
  "package": "Ocean",
  "ticks_per_sec": 200,
  "assumptions": {
    "imu_noise": "ASSUMPTION consumer-MEMS class per-sample sigmas at 200 Hz; replace with platform Allan-variance values after the IMU arrives",
    "depth_sigma_m": "ASSUMPTION 2 cm per sample",
    "sonar_elevation_deg": "ASSUMPTION 20 deg until the platform vertical aperture is measured (do not cite as the platform value)",
    "scene_geometry": "wall from identical [10, 0.5, 1] boxes; the tilted half is a staircase of [10, 0.5, 0.1] rows set back 0.1*tan(35 deg) each (spawn_prop rotation does not tilt box faces: slope probe); riser 0.1 m is finer than the sonar elevation footprint"
  },
