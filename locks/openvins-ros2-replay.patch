+void ROS2Visualizer::shutdown() {
+  if (stopping.exchange(true)) return;
+  if (update_thread.joinable()) update_thread.join();
+  if (image_thread.joinable()) image_thread.join();
+  if (!input_trace_path.empty()) {
+    std::ofstream trace(input_trace_path);
+    trace << "event,stamp_ns,secondary_ns,steady_ns\n";
+    for (const auto &row : input_trace)
+      trace << row.event << ',' << row.stamp_ns << ',' << row.secondary_ns << ',' << row.steady_ns << '\n';
+    if (!trace) PRINT_ERROR("Cannot write OpenVINS input trace\n");
   }
 }
 
