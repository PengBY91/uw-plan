+void ROS2Visualizer::trace_input(const char *event, int64_t stamp_ns, int64_t secondary_ns) {
+  if (input_trace_path.empty()) return;
+  auto now = std::chrono::steady_clock::now().time_since_epoch();
+  std::lock_guard<std::mutex> lock(input_trace_mtx);
+  input_trace.push_back({event, stamp_ns, secondary_ns,
+                        std::chrono::duration_cast<std::chrono::nanoseconds>(now).count()});
