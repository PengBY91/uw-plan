# Track team source, explicit configs and small provenance records only.
*
!.gitignore
!README.md
!scripts/
!scripts/*.py
!scripts/*.sh
!team/
!team/*.py
!team/*.cpp
!team/*.h
!team/uwbench/
!team/uwbench/pyproject.toml
!team/uwbench/**/
!team/uwbench/**/*.py
!configs/
!configs/*.yaml
!configs/euroc_v101/
!configs/euroc_v101/*.yaml
!configs/a1/
!configs/a1/*.yaml
!configs/sim/
!configs/sim/*.json
!team/sim/
!team/sim/*.py
!manifests/
!manifests/*.yaml
!manifests/*.json
!locks/
!locks/*.json
!locks/*.txt
!locks/*.patch
!locks/*.sha256
!reports/
!reports/w1/
!reports/w1/*.md
!reports/w2/
!reports/w2/*.md
!reports/w1/euroc_v101_audit/
!reports/w1/euroc_v101_audit/*

!configs/cyclonedds-local.xml

!reports/w1/baseline-summary.json
!reports/w1/v101-calibration-check.json

!.gitattributes

!reports/w1/replay-fix-summary.json
